TASKFORGE_PRIMARY.ENV="local"

TASKFORGE_SERVER.PORT="8080"
TASKFORGE_SERVER.READ_TIMEOUT="30"
TASKFORGE_SERVER.WRITE_TIMEOUT="30"
TASKFORGE_SERVER.IDLE_TIMEOUT="60"
TASKFORGE_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

TASKFORGE_DATABASE.HOST="localhost"
TASKFORGE_DATABASE.PORT="5432"
TASKFORGE_DATABASE.USER="postgres"
TASKFORGE_DATABASE.PASSWORD=""
TASKFORGE_DATABASE.NAME="taskForge"
TASKFORGE_DATABASE.SSL_MODE="disable"
TASKFORGE_DATABASE.MAX_OPEN_CONNS="25"
TASKFORGE_DATABASE.MAX_IDLE_CONNS="25"
TASKFORGE_DATABASE.CONN_MAX_LIFETIME="300"
TASKFORGE_DATABASE.CONN_MAX_IDLE_TIME="300"

TASKFORGE_AUTH.SECRET_KEY="secret"

TASKFORGE_INTEGRATION.RESEND_API_KEY="resend_key"

TASKFORGE_REDIS.ADDRESS="localhost:6380"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
TASKFORGE_OBSERVABILITY.SERVICE_NAME="taskForge"
TASKFORGE_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
TASKFORGE_OBSERVABILITY.LOGGING.LEVEL="debug"
TASKFORGE_OBSERVABILITY.LOGGING.FORMAT="console"
TASKFORGE_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
TASKFORGE_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TASKFORGE_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
TASKFORGE_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
TASKFORGE_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
TASKFORGE_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
TASKFORGE_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
TASKFORGE_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
TASKFORGE_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"